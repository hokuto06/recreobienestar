# ─────────────────────────────────────────────────────────────────
# Recreo Bienestar — Django backend/admin
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────

# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=False

# Comma-separated, no spaces.
ALLOWED_HOSTS=recreobienestar.com,www.recreobienestar.com
CSRF_TRUSTED_ORIGINS=https://recreobienestar.com,https://www.recreobienestar.com

# Custom admin path (no leading slash, trailing slash required)
ADMIN_URL=gestion/

# Database (dedicated Postgres container, internal Docker network only)
DB_NAME=changeme
DB_USER=changeme
DB_PASSWORD=changeme
DB_HOST=recreo-db
DB_PORT=5432

# Mercado Pago (Phase 4B-1: checkout initiation — TEST/sandbox credentials
# for now). Access token is used server-side to create preferences; public
# key is for a future frontend Checkout Bricks integration.
MERCADOPAGO_ACCESS_TOKEN=changeme
MERCADOPAGO_PUBLIC_KEY=changeme

# Phase 4B-2: secret signature for verifying Mercado Pago webhook
# notifications (x-signature header on POST /api/mercadopago/webhook/).
# Get this from your MP application's "Webhooks" config panel — it is
# NOT the access token. Never commit the real value.
MERCADOPAGO_WEBHOOK_SECRET=changeme

# Set to False only if this service is ever run without a TLS-terminating
# proxy in front of it (e.g. plain local development).
DJANGO_SECURE_SSL_REDIRECT=True

# Root logging level (see config/settings.py's LOGGING dict) — everything
# at this level and above goes to stdout, read via `docker logs
# recreo-django`. Optional: has a default (INFO), so unset is fine. Rarely
# needs changing; DEBUG only for temporary local troubleshooting (very
# chatty), WARNING to quiet things down.
DJANGO_LOG_LEVEL=INFO

# ── recreo-nginx: certificate mount paths (read by docker-compose.yml) ──
# Absolute host paths — the one deliberate dependency on nginx-flask-prod,
# kept because the cert is a live, renewed credential (see
# ARCHITECTURE.md). Defaults match the current server; override only if
# the cert is ever migrated to a fully independent renewal setup.
LETSENCRYPT_DIR=/home/ubuntu/nginx-flask-prod/letsencrypt
CERTBOT_WEBROOT_DIR=/home/ubuntu/nginx-flask-prod/certbot/www
