# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp
*.swo

# Logs y temporales
*.log
*.tmp
*.bak
*~

# Por si en el futuro se agrega tooling de Node
node_modules/

# Django backend
backend/.env
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/staticfiles/
backend/media/
backend/db.sqlite3
backend/.venv/
backend/venv/

# nginx: static-root is populated at deploy time from the repo root's own
# index.html/css/js/etc — the single canonical, git-tracked copy of the
# static site. Never duplicated into git a second time here.
backend/nginx/static-root/*
!backend/nginx/static-root/.gitkeep
backend/nginx/logs/*
!backend/nginx/logs/.gitkeep


# Source photos for uploaded media (e.g. Carla's photo, seeded with
# `manage.py set_carla_photo`) live OUTSIDE the repo, never at its root:
# the repo root is rsynced verbatim into nginx/static-root/, so an image
# left here would be published as https://recreobienestar.com/<file>.
# Uploaded media belongs in backend/media/ (ignored above) only.
/*.jpg
/*.jpeg
/*.png
/*.webp
/*.heic
